    },
    {
      "start": 86.04,
      "end": 88.22,
      "text": "Senden önce sanın geldi ha."
    },
    {
      "start": 91.5,
      "end": 95.66,
      "text": "Şimdi ben sana direkt hemen hızlıca başlayayım."
    },
    {
      "start": 96.0,
      "end": 97.84,
      "text": "Bir ekran paylaşıyorum. Tamam."
    },
    {
      "start": 98.76,
      "end": 100.56,
      "text": "Ne yapmak istediğimi anlatayım."
    },
    {
      "start": 100.7,
