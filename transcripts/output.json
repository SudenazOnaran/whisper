    },
    {
      "start": 178.9,
      "end": 181.44,
      "text": "Evet, evet kullanılır ya baya."
    },
    {
      "start": 184.24,
      "end": 187.84,
      "text": "Ondan zaten deneyelim, boşa denemeyelim diye aklıma geldi."
    },
    {
      "start": 188.0,
      "end": 188.94,
      "text": "Bunları da ne yaptım?"
    },
    {
      "start": 189.66,
      "end": 192.42,
      "text": "Şurada mobili yukarıma trendler arama yaptım."
    },
    {
      "start": 192.8,
      "end": 194.74,
      "text": "Web aramasını açarak arama yapıyorum."
    },
    {
      "start": 194.74,
      "end": 195.66,
      "text": "Çeşit çepeydi de."
    },
    {
      "start": 195.7,
      "end": 197.64,
      "text": "Bunu cemin ayda da yapabilirsin."
    },
    {
      "start": 198.96,
      "end": 206.02,
      "text": "Hatta arama sonuç verilerine raporlarına bakarak arama trendlerine bakarak bir araştırma yaptı diyebilirsin."
    },
    {
      "start": 206.26,
      "end": 210.72,
      "text": "Web araması için en iyi seçerlik işte şey yazdım."
    },
    {
      "start": 210.94,
      "end": 220.42,
      "text": "Şöyle bana üretilecek global trend olan mobili yukarıma örneklerini bana paylaşman istiyorum."
    },
    {
      "start": 220.7,
      "end": 222.36,
