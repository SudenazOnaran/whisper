    {
      "start": 264.3,
      "end": 265.72,
      "text": "Yani çok daha iyi oluyor."
    },
    {
      "start": 265.96,
      "end": 269.48,
      "text": "Hatta ben şöyle bir şey yaptım bu tip uygulamalarda."
    },
    {
      "start": 270.12,
      "end": 272.16,
      "text": "Örnek bir daha orada da göstereyim."
    },
    {
