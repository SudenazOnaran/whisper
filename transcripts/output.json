    },
    {
      "start": 222.36,
      "end": 225.02,
      "text": "Böyle sıralama vermiş."
    },
    {
      "start": 225.18,
      "end": 232.28,
      "text": "Bunları verdi sonrasında dedim ki bunlar değil de genelde kolay üretilebilir uygamı örnekleriyle ilginiyorum yazdım."
    },
    {
      "start": 232.58,
      "end": 235.46,
      "text": "Böyle şeyler çıkarttı sonra vesaire."
    },
    {
      "start": 236.32,
      "end": 239.1,
      "text": "Şimdi şurada nerede ol?"
    },
    {
      "start": 240.22,
      "end": 241.12,
      "text": "Şuradan açayım."
    },
    {
      "start": 242.78,
      "end": 245.64,
      "text": "Şöyle bir prompt verdi ya."
    },
    {
      "start": 247.12,
      "end": 249.08,
      "text": "Bunu kopyalıyoruz bildiğin mantık."
    },
    {
      "start": 253.5,
      "end": 254.6,
