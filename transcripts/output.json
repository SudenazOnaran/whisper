    },
    {
      "start": 108.7,
      "end": 111.04,
      "text": "Daha gelmedi ama başlatılıyor."
    },
    {
      "start": 112.04,
      "end": 114.54,
      "text": "Tamam burası kalsın."
    },
    {
      "start": 114.9,
      "end": 118.88,
      "text": "Şimdi burada bir şey söyleyeceğim."
    },
    {
      "start": 163.98,
